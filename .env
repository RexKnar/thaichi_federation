# ==============================================================
# Environment Variables Example for TaiChi Federation Website
# Copy this file to `.env.local` for local development
# ==============================================================

# Sender Gmail Address (used by Nodemailer to authenticate and send emails)
SMTP_USER=rexknar@gmail.com

# Google App Password (16 characters generated under Google Account > Security > 2-Step Verification > App passwords)
# Note: Do NOT use your regular Gmail password.
SMTP_PASS=qpwj efgh dohw gdcw

# Destination email address where contact form submissions will be received
# Defaults to authenticacademy.official@gmail.com if not specified
SMTP_RECEIVER=authenticacademy.official@gmail.com
